{
  "entities": {
    "Schedule": {
      "title": "Schedule",
      "description": "Modelo configurável de escala de serviço do batalhão com quantidade flexível de colunas e funções.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "shortCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "order": {
          "type": "number"
        },
        "columns": {
          "type": "array",
          "description": "Lista ordenada de colunas de função (até 20 colunas por escala)."
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "shortCode",
        "description",
        "order",
        "columns",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduleEntry": {
      "title": "ScheduleEntry",
      "description": "Registro diário de serviço pertencente a uma escala específica, identificado por data ISO YYYY-MM-DD.",
      "type": "object",
      "properties": {
        "scheduleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dayOfWeek": {
          "type": "string",
          "enum": ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"]
        },
        "isRedScale": {
          "type": "boolean"
        },
        "holidayLabel": {
          "type": "string",
          "maxLength": 60
        },
        "assignments": {
          "type": "object",
          "description": "Mapa dinâmico de columnId para nome do militar escalado (incluindo substituições entre parênteses)."
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "scheduleId",
        "date",
        "dayOfWeek",
        "isRedScale",
        "holidayLabel",
        "assignments",
        "notes",
        "updatedAt"
      ]
    },
    "PersonnelProfile": {
      "title": "PersonnelProfile",
      "description": "Cadastro individual centralizado de cada militar do efetivo, criado automaticamente ou importado em lote.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "warName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "rank": {
          "type": "string",
          "maxLength": 40
        },
        "company": {
          "type": "string",
          "maxLength": 60
        },
        "normalizedKey": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "active": {
          "type": "boolean"
        },
        "scaleMode": {
          "type": "string",
          "enum": ["both", "black_only", "red_only", "none"],
          "description": "Elegibilidade de escala do militar: ambas, somente preta, somente vermelha ou dispensado."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "fullName",
        "warName",
        "rank",
        "company",
        "normalizedKey",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "MissionRecord": {
      "title": "MissionRecord",
      "description": "Registro estruturado de missão atribuída a militares do efetivo em um intervalo de datas.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "startDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "personnelIds": {
          "type": "array",
          "description": "Lista de IDs dos militares designados para a missão (até 100 militares)."
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["active", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "location",
        "startDate",
        "endDate",
        "personnelIds",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaveRecord": {
      "title": "LeaveRecord",
      "description": "Registro oficial de folga concedida administrativamente a um militar (identificação F na planilha dinâmica).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "personId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "startDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reason": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["active", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "personId",
        "startDate",
        "endDate",
        "reason",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro imutável do histórico de alterações administrativas nas escalas, efetivo, missões e folgas.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create_schedule",
            "update_schedule",
            "delete_schedule",
            "update_entries",
            "create_period",
            "delete_entry",
            "seed_initial",
            "create_personnel",
            "update_personnel",
            "deactivate_personnel",
            "import_personnel",
            "create_mission",
            "update_mission",
            "delete_mission",
            "create_leave",
            "delete_leave",
            "update_calendar_day"
          ]
        },
        "scheduleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scheduleName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "details": {
          "type": "string",
          "maxLength": 1000
        },
        "actorLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "action",
        "scheduleId",
        "scheduleName",
        "summary",
        "details",
        "actorLabel",
        "createdAt"
      ]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Registro de administradores autorizados para escrita no banco.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["role", "createdAt"]
    },
    "AdminSecurityConfig": {
      "title": "AdminSecurityConfig",
      "description": "Hash criptográfico (PBKDF2-SHA256 com salt) da senha única administrativa, restrito exclusivamente a administradores verificados.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["passcode"]
        },
        "algorithm": {
          "type": "string",
          "enum": ["PBKDF2-SHA256"]
        },
        "iterations": {
          "type": "number"
        },
        "salt": {
          "type": "string",
          "minLength": 32,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$"
        },
        "hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 128,
          "pattern": "^[a-f0-9]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "algorithm", "iterations", "salt", "hash", "updatedAt"]
    },
    "CalendarDayOverride": {
      "title": "CalendarDayOverride",
      "description": "Definição administrativa global de dia em escala vermelha ou preta (feriados, pontos facultativos ou exceções).",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "isRedScale": {
          "type": "boolean"
        },
        "holidayLabel": {
          "type": "string",
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["date", "isRedScale", "holidayLabel", "updatedAt"]
    }
  },
  "firestore": {
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "Coleção principal de modelos de escalas de serviço do batalhão."
    },
    "/schedules/{scheduleId}/entries/{dateId}": {
      "schema": { "$ref": "#/entities/ScheduleEntry" },
      "description": "Subcoleção de registros diários vinculados a cada modelo de escala."
    },
    "/personnel/{personId}": {
      "schema": { "$ref": "#/entities/PersonnelProfile" },
      "description": "Base centralizada de militares do efetivo utilizada por escalas, missões, folgas e planilha dinâmica."
    },
    "/missions/{missionId}": {
      "schema": { "$ref": "#/entities/MissionRecord" },
      "description": "Missões cadastradas com período e militares designados."
    },
    "/leaves/{leaveId}": {
      "schema": { "$ref": "#/entities/LeaveRecord" },
      "description": "Folgas oficialmente concedidas aos militares."
    },
    "/calendar_days/{dateId}": {
      "schema": { "$ref": "#/entities/CalendarDayOverride" },
      "description": "Configuração global de dias de escala vermelha/feriados sincronizada com a planilha dinâmica e as escalas."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Histórico imutável de alterações realizadas pela administração, com leitura e escrita restritas exclusivamente a administradores."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Lista restrita de administradores com permissão de escrita."
    },
    "/admin_security/{configId}": {
      "schema": { "$ref": "#/entities/AdminSecurityConfig" },
      "description": "Configuração restrita do hash da senha administrativa para ambientes estáticos/PWA."
    }
  }
}
