rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(id) {
      return id is string && id.size() == 10 && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'mayconpaulo6000@gmail.com' ||
        request.auth.token.email == 'bda1bimec@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidSchedule(data, scheduleId) {
      return data.keys().hasAll([
        'id', 'name', 'shortCode', 'description', 'order', 'columns', 'active', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'name', 'shortCode', 'description', 'order', 'columns', 'active', 'createdAt', 'updatedAt'
      ]) &&
      data.id == scheduleId &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
      data.shortCode is string && data.shortCode.size() >= 1 && data.shortCode.size() <= 24 &&
      data.description is string && data.description.size() <= 400 &&
      data.order is number && data.order >= 0 && data.order <= 999 &&
      data.columns is list && data.columns.size() >= 1 && data.columns.size() <= 20 &&
      data.columns[0] is map &&
      data.active is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidEntry(data, scheduleId, dateId) {
      return data.keys().hasAll([
        'scheduleId', 'date', 'dayOfWeek', 'isRedScale', 'holidayLabel', 'assignments', 'notes', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'scheduleId', 'date', 'dayOfWeek', 'isRedScale', 'holidayLabel', 'assignments', 'notes', 'updatedAt'
      ]) &&
      data.scheduleId == scheduleId &&
      isValidId(data.scheduleId) &&
      data.date == dateId &&
      isValidDateId(data.date) &&
      data.dayOfWeek in ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'] &&
      data.isRedScale is bool &&
      data.holidayLabel is string && data.holidayLabel.size() <= 60 &&
      data.assignments is map && data.assignments.keys().size() <= 25 &&
      data.notes is string && data.notes.size() <= 300 &&
      data.updatedAt is timestamp;
    }

    function isValidPersonnel(data, personId) {
      return data.keys().hasAll([
        'id', 'fullName', 'warName', 'rank', 'company', 'normalizedKey', 'active', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'fullName', 'warName', 'rank', 'company', 'normalizedKey', 'active', 'scaleMode', 'blockedPeriods', 'createdAt', 'updatedAt'
      ]) &&
      data.id == personId &&
      isValidId(data.id) &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
      data.warName is string && data.warName.size() >= 2 && data.warName.size() <= 80 &&
      data.rank is string && data.rank.size() <= 40 &&
      data.company is string && data.company.size() <= 60 &&
      data.normalizedKey is string && data.normalizedKey.size() >= 2 && data.normalizedKey.size() <= 140 &&
      data.active is bool &&
      (!('scaleMode' in data) || data.scaleMode in ['both', 'black_only', 'red_only', 'none']) &&
      (!('blockedPeriods' in data) || (
        data.blockedPeriods is list &&
        data.blockedPeriods.size() <= 20 &&
        (data.blockedPeriods.size() == 0 || data.blockedPeriods[0] is map)
      )) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCalendarDay(data, dateId) {
      return data.keys().hasAll([
        'date', 'isRedScale', 'holidayLabel', 'active', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'date', 'isRedScale', 'holidayLabel', 'active', 'updatedAt'
      ]) &&
      data.date == dateId &&
      isValidDateId(data.date) &&
      data.isRedScale is bool &&
      data.holidayLabel is string && data.holidayLabel.size() <= 60 &&
      data.active == true &&
      data.updatedAt is timestamp;
    }

    function isValidMission(data, missionId) {
      return data.keys().hasAll([
        'id', 'title', 'location', 'startDate', 'endDate', 'personnelIds', 'notes', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'location', 'startDate', 'endDate', 'personnelIds', 'notes', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.id == missionId &&
      isValidId(data.id) &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
      data.location is string && data.location.size() <= 120 &&
      isValidDateId(data.startDate) &&
      isValidDateId(data.endDate) &&
      data.endDate >= data.startDate &&
      data.personnelIds is list && data.personnelIds.size() <= 100 &&
      (data.personnelIds.size() == 0 || data.personnelIds[0] is string) &&
      data.notes is string && data.notes.size() <= 300 &&
      data.status in ['active', 'cancelled'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLeave(data, leaveId) {
      return data.keys().hasAll([
        'id', 'personId', 'startDate', 'endDate', 'reason', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'personId', 'startDate', 'endDate', 'reason', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.id == leaveId &&
      isValidId(data.id) &&
      isValidId(data.personId) &&
      isValidDateId(data.startDate) &&
      isValidDateId(data.endDate) &&
      data.endDate >= data.startDate &&
      data.reason is string && data.reason.size() <= 120 &&
      data.status in ['active', 'cancelled'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'action', 'scheduleId', 'scheduleName', 'summary', 'details', 'actorLabel', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'action', 'scheduleId', 'scheduleName', 'summary', 'details', 'actorLabel', 'createdAt'
      ]) &&
      data.action in [
        'create_schedule', 'update_schedule', 'delete_schedule',
        'update_entries', 'create_period', 'delete_entry', 'seed_initial',
        'create_personnel', 'update_personnel', 'deactivate_personnel', 'import_personnel',
        'create_mission', 'update_mission', 'delete_mission',
        'create_leave', 'delete_leave', 'update_calendar_day'
      ] &&
      isValidId(data.scheduleId) &&
      data.scheduleName is string && data.scheduleName.size() >= 1 && data.scheduleName.size() <= 120 &&
      data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 240 &&
      data.details is string && data.details.size() <= 1000 &&
      data.actorLabel == 'Administrador' &&
      data.createdAt is timestamp;
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['role', 'createdAt']) &&
      data.keys().hasOnly(['role', 'createdAt']) &&
      data.role == 'admin' &&
      data.createdAt is timestamp;
    }

    function isValidAdminSecurityConfig(data, configId) {
      return data.keys().hasAll([
        'id', 'algorithm', 'iterations', 'salt', 'hash', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'algorithm', 'iterations', 'salt', 'hash', 'updatedAt'
      ]) &&
      data.id == configId &&
      configId == 'passcode' &&
      data.algorithm == 'PBKDF2-SHA256' &&
      data.iterations is number && data.iterations >= 100000 && data.iterations <= 500000 &&
      data.salt is string && data.salt.size() >= 32 && data.salt.size() <= 64 && data.salt.matches('^[a-f0-9]+$') &&
      data.hash is string && data.hash.size() >= 64 && data.hash.size() <= 128 && data.hash.matches('^[a-f0-9]+$') &&
      data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && (resource == null || existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();

      allow create: if isAdmin() &&
        isValidId(scheduleId) &&
        isValidSchedule(incoming(), scheduleId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(scheduleId) &&
        isValidSchedule(incoming(), scheduleId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'shortCode', 'description', 'order', 'columns', 'active', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(scheduleId);

      match /entries/{dateId} {
        allow get: if isValidId(scheduleId) && isValidDateId(dateId);
        allow list: if isValidId(scheduleId) && existing().scheduleId == scheduleId;

        allow create: if isAdmin() &&
          isValidId(scheduleId) &&
          isValidDateId(dateId) &&
          isValidEntry(incoming(), scheduleId, dateId) &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/schedules/$(scheduleId));

        allow update: if isAdmin() &&
          isValidId(scheduleId) &&
          isValidDateId(dateId) &&
          isValidEntry(incoming(), scheduleId, dateId) &&
          incoming().scheduleId == existing().scheduleId &&
          incoming().date == existing().date &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'dayOfWeek', 'isRedScale', 'holidayLabel', 'assignments', 'notes', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/schedules/$(scheduleId));

        allow delete: if isAdmin() && isValidId(scheduleId) && isValidDateId(dateId);
      }
    }

    match /personnel/{personId} {
      allow get: if isValidId(personId) && (resource == null || existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();

      allow create: if isAdmin() &&
        isValidId(personId) &&
        isValidPersonnel(incoming(), personId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(personId) &&
        isValidPersonnel(incoming(), personId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'warName', 'rank', 'company', 'normalizedKey', 'active', 'scaleMode', 'blockedPeriods', 'updatedAt'
        ]);

      // Soft-deactivation only so historical duties and missions are never orphaned
      allow delete: if false;
    }

    match /calendar_days/{dateId} {
      allow get: if isValidDateId(dateId) && (resource == null || existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();

      allow create: if isAdmin() &&
        isValidDateId(dateId) &&
        isValidCalendarDay(incoming(), dateId) &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidDateId(dateId) &&
        isValidCalendarDay(incoming(), dateId) &&
        incoming().date == existing().date &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isRedScale', 'holidayLabel', 'active', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidDateId(dateId);
    }

    match /missions/{missionId} {
      allow get: if isValidId(missionId) && (resource == null || existing().status == 'active' || isAdmin());
      allow list: if existing().status == 'active' || isAdmin();

      allow create: if isAdmin() &&
        isValidId(missionId) &&
        isValidMission(incoming(), missionId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(missionId) &&
        isValidMission(incoming(), missionId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'location', 'startDate', 'endDate', 'personnelIds', 'notes', 'status', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(missionId);
    }

    match /leaves/{leaveId} {
      allow get: if isValidId(leaveId) && (resource == null || existing().status == 'active' || isAdmin());
      allow list: if existing().status == 'active' || isAdmin();

      allow create: if isAdmin() &&
        isValidId(leaveId) &&
        isValidLeave(incoming(), leaveId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/personnel/$(incoming().personId));

      allow update: if isAdmin() &&
        isValidId(leaveId) &&
        isValidLeave(incoming(), leaveId) &&
        incoming().id == existing().id &&
        incoming().personId == existing().personId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'startDate', 'endDate', 'reason', 'status', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(leaveId);
    }

    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin() && existing().actorLabel == 'Administrador';

      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if isVerifiedUser() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() && existing().role == 'admin';

      allow create: if isAdmin() &&
        isValidId(uid) &&
        isValidAdminMember(incoming()) &&
        incoming().createdAt == request.time;

      allow update, delete: if isAdmin() && isValidId(uid);
    }

    match /admin_security/{configId} {
      allow get: if isAdmin() && isValidId(configId) && configId == 'passcode';
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(configId) &&
        configId == 'passcode' &&
        isValidAdminSecurityConfig(incoming(), configId) &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(configId) &&
        configId == 'passcode' &&
        isValidAdminSecurityConfig(incoming(), configId) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'algorithm', 'iterations', 'salt', 'hash', 'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
